    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync needs calendar access to display live countdowns for your classes and events. Your data stays on your device and is never uploaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySyncでは、授業やイベントのリアルタイムカウントダウンを表示するためにカレンダーへのアクセスが必要です。データはデバイス内でのみ使用され、アップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync는 수업과 이벤트의 실시간 카운트다운을 표시하기 위해 캘린더 접근이 필요해요. 데이터는 기기 내에서만 사용되며 업로드되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要访问你的日历来显示课程和事件的实时倒计时。你的数据仅在本地使用，不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要存取你的日曆來顯示課程和事件的即時倒數。你的資料僅在本地使用，不會上傳。"
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync needs permission to write countdown events to your calendar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySyncは、カウントダウンイベントをカレンダーに書き込む権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync가 카운트다운 이벤트를 캘린더에 기록하려면 권한이 필요해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要将倒计时事件写入你的日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要將倒數事件寫入你的日曆。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync needs camera access to scan team project invite QR codes, and boarding pass / train ticket barcodes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要使用相机扫描团队项目邀请二维码，以及机票、高铁票等行程的条码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要使用相機掃描團隊項目邀請 QR 碼，以及機票、高鐵票等行程的條碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync는 팀 프로젝트 초대 QR 코드와 탑승권 / 열차 티켓 바코드를 스캔하기 위해 카메라 접근이 필요해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySyncは、チームプロジェクトの招待QRコードと搭乗券 / 列車チケットのバーコードをスキャンするためにカメラへのアクセスを必要とします。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync uses your location to calculate distance and ETA to meetup locations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySyncは、集合場所までの距離と到着予定時刻を計算するために位置情報を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync는 모임 장소까지의 거리와 예상 도착 시간을 계산하기 위해 위치 정보가 필요해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要你的位置来计算到集合地点的距离和预计到达时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要你的位置來計算到集合地點的距離和預計到達時間。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync needs access to your photo library to save share cards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySyncは、共有カードを保存するために写真へのアクセスを必要とします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync는 공유 카드를 저장하기 위해 사진에 접근해야 해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要访问你的相册来保存分享卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StudySync 需要存取你的相簿來儲存分享卡片。"
          }
        }
      }
    },
    "今日日程": {
