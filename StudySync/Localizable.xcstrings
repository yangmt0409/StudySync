          "stringUnit": {
            "state": "translated",
            "value": "삭제하면 모든 성적 기록이 제거되며 복구할 수 없어요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除後所有成績記錄將被清除，無法恢復"
