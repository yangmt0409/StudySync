        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dueイベントが近づくと、ロック画面とダイナミックアイランドにリアルタイムカウントダウンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Due 이벤트가 가까워지면 잠금화면과 다이내믹 아일랜드에 실시간 카운트다운을 표시해요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Due 事件臨近時，在鎖定畫面和靈動島顯示即時倒數。"
