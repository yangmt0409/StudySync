          }
        }
      }
    },
    "删除后所有成绩记录将被清除，无法恢复": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All grade records will be permanently deleted and cannot be recovered"
          }
        },
