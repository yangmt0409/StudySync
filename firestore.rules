rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Early bird Pro grant — tamper-proof constants
    //
    // Policy: anyone who signed up before Apr 24 23:59:59 Toronto time
    // (= Apr 25 00:00 EDT = Apr 25 04:00 UTC) gets lifetime Pro on their
    // first launch on/after Apr 27 00:00 Toronto time.
    //
    // The client reconciler writes `proLifetime = true` once eligible.
    // These rules make sure a malicious client cannot:
    //   - edit createdAt to fake eligibility
    //   - flip proLifetime from false → true without meeting conditions
    //   - revoke their own grant (proLifetime can only go false → true)
    //   - forge earlyBirdGrantedAt after the fact
    // ============================================================
    function earlyBirdRegistrationCutoffMs()  { return 1777089600000; }  // 2026-04-25 04:00 UTC
    function earlyBirdGrantActiveFromMs()     { return 1777262400000; }  // 2026-04-27 04:00 UTC

    function fieldUnchanged(field) {
      return (field in resource.data) == (field in request.resource.data)
        && (!(field in resource.data) || request.resource.data[field] == resource.data[field]);
    }

    function createdAtImmutable() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    function proLifetimeWriteAllowed() {
      let oldLifetime = resource.data.get('proLifetime', false);
      let newLifetime = request.resource.data.get('proLifetime', false);
      return
        // unchanged
        newLifetime == oldLifetime
        // OR: valid false→true transition with registration + grant-window eligibility
        || (
          oldLifetime == false
          && newLifetime == true
          && resource.data.createdAt.toMillis() < earlyBirdRegistrationCutoffMs()
          && request.time.toMillis() >= earlyBirdGrantActiveFromMs()
        );
    }

    function earlyBirdGrantedAtWriteAllowed() {
      let oldSet = 'earlyBirdGrantedAt' in resource.data
        && resource.data.earlyBirdGrantedAt != null;
      let newSet = 'earlyBirdGrantedAt' in request.resource.data
        && request.resource.data.earlyBirdGrantedAt != null;
      return
        // unchanged (both unset, or both set to same value)
        fieldUnchanged('earlyBirdGrantedAt')
        // OR: first-time set alongside a valid proLifetime grant
        || (
          !oldSet
          && newSet
          && request.resource.data.proLifetime == true
          && request.resource.data.earlyBirdGrantedAt == request.time
        );
    }

    // proRewardExpiresAt backs UserProfile.isProActive() and is therefore a
    // monetization-critical field. The client legitimately writes it when it
    // grants the focus-challenge reward (a 3-month window), but without a
    // bound a malicious client owning its own doc could set it to year-3000
    // and self-grant permanent Pro — bypassing all the proLifetime hardening.
    // We can't verify the challenge server-side from rules, so we cap the
    // value at now + 100 days (the reward is ~3 months) to contain abuse.
    function proRewardExpiresAtWriteAllowed() {
      return
        // unchanged, or explicitly cleared
        fieldUnchanged('proRewardExpiresAt')
        || !('proRewardExpiresAt' in request.resource.data)
        // OR: a bounded forward grant (<= now + 100 days)
        || (
          request.resource.data.proRewardExpiresAt is timestamp
          && request.resource.data.proRewardExpiresAt.toMillis()
             <= request.time.toMillis() + 8640000000
        );
    }

    // ============================================================
    // Project membership helper
    // ============================================================
    // Used by every subcollection under /projects/{projectId}/... to
    // gate access to people who are actually members. Costs 1 extra
    // Firestore read per request, but that's the price of correctness —
    // before this gate, any authenticated user could read/write any
    // project's dues / activities / meetup data.
    function isProjectMember(projectId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && request.auth.uid in
           get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds;
    }

    // ============================================================
    // Project document write guards
    // ============================================================
    // createdBy / createdAt / projectCode are immutable for the life of the
    // project. Without pinning them, any member could rewrite createdBy to
    // themselves (delete is gated on createdBy → ownership + cascade-delete
    // takeover) or rotate the join code.
    function projImmutableFieldsOK() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && fieldUnchanged('projectCode');
    }
    // The only legitimate memberIds mutations are: a non-member adding ONLY
    // themselves (self-join) or a member removing ONLY themselves (self-leave).
    // Everything else (meetup/meeting/meta edits) leaves memberIds untouched.
    // This blocks mass-kick / non-member bulk-grant attacks.
    function projAddedMembers()   { return request.resource.data.memberIds.removeAll(resource.data.memberIds); }
    function projRemovedMembers() { return resource.data.memberIds.removeAll(request.resource.data.memberIds); }
    function projMembershipDeltaSelfOnly() {
      return (projAddedMembers().size() == 0 && projRemovedMembers().hasOnly([request.auth.uid]))
          || (projRemovedMembers().size() == 0 && projAddedMembers().hasOnly([request.auth.uid]));
    }

    // User profiles - public read is required for friend-code lookup;
    // sensitive fields (fcmToken, locale, email) are still exposed and
    // any client that reads them gets them. This is a known tradeoff —
    // removing it would require a Cloud-Function-only friend-discovery
    // path, which is out of scope for this hotfix. Only the owner can
    // write, and update is locked down against Pro entitlement tampering.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId
                    // New accounts cannot be born lifetime — that can only
                    // happen through the reconciler path with server-time check.
                    && request.resource.data.get('proLifetime', false) == false
                    && !('earlyBirdGrantedAt' in request.resource.data
                         && request.resource.data.earlyBirdGrantedAt != null);
      allow update: if request.auth.uid == userId
                    && createdAtImmutable()
                    && proLifetimeWriteAllowed()
                    && earlyBirdGrantedAtWriteAllowed()
                    && proRewardExpiresAtWriteAllowed();
      allow delete: if request.auth.uid == userId;

      // Owner-only private data — FCM push token + locale live here instead
      // of on the publicly readable user doc so other authed users can't
      // harvest every user's push token / language. Cloud Functions read it
      // via the Admin SDK (which bypasses rules).
      match /private/{docId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Friends subcollection. The friend graph is private to each owner
      // — neither side of a friendship should be able to enumerate the
      // other side's full friend list. Writes still allowed from either
      // end so reciprocal friend records work.
      match /friends/{friendId} {
        allow read: if request.auth.uid == userId;
        // The owner fully manages their own friend list.
        allow write: if request.auth.uid == userId;
        // The reciprocal half of an accept writes into the OTHER party's list
        // (auth.uid == friendId). Require that this party actually sent the
        // owner a friend request — otherwise any user could force-add
        // themselves into anyone's friends list by writing the reciprocal doc
        // directly. The request doc id is the sender uid and carries fromUid,
        // so we verify both exist and match.
        allow create, update: if request.auth.uid == friendId
                     && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friendRequests/$(userId))
                     && get(/databases/$(database)/documents/users/$(request.auth.uid)/friendRequests/$(userId)).data.fromUid == userId;
        // Either party may unfriend (deletes the reciprocal doc).
        allow delete: if request.auth.uid == friendId;
      }

      // Friend requests - recipient can read/delete. Create is open to any
      // authed user BUT fromUid must equal the writer's own uid, so a sender
      // can't be impersonated (the recipient renders fromName/fromEmoji).
      match /friendRequests/{requestId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.resource.data.fromUid == request.auth.uid;
        allow delete: if request.auth.uid == userId;
      }

      // Nudges (拍一拍) - recipient can read/delete. fromUid is pinned to the
      // writer so a nudge can't claim to come from a third party.
      match /nudges/{nudgeId} {
        allow read, delete: if request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.resource.data.fromUid == request.auth.uid;
      }

      // Ring nudges (响铃拍一拍) - same pattern as nudges. Pinning fromUid is
      // especially important here: the Cloud Function fires a DND-bypassing
      // CRITICAL push, so the delivery confirmation must go to the real sender.
      match /ringNudges/{nudgeId} {
        allow read, delete: if request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.resource.data.fromUid == request.auth.uid;
      }

      // Shared dues - private to owner. Pre-1.0.3 this allowed any
      // authed user to read another user's shared dues; that leaked
      // both work content and collaboration relationships.
      match /sharedDues/{dueId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Project memberships - the owner's own membership index. Pre-
      // 1.0.3 any authed user could write this subcollection, which
      // meant user A could fabricate a project membership for user B.
      match /projectMemberships/{membershipId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Project invites - recipient reads/deletes, any authed user can create
      match /projectInvites/{inviteId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth != null;
        allow delete: if request.auth.uid == userId;
      }

      // Study goals - private to owner
      match /studyGoals/{goalId} {
        allow read, write: if request.auth.uid == userId;

        match /checkIns/{checkInId} {
          allow read, write: if request.auth.uid == userId;
        }
      }

      // Countdown events - private to owner
      match /countdownEvents/{eventId} {
        allow read, write: if request.auth.uid == userId;
      }

      // User settings (timezone, prefs) - private to owner
      match /settings/{settingsId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Deadline records (EventKit completion flags) - private to owner
      match /deadlineRecords/{recordId} {
        allow read, write: if request.auth.uid == userId;
      }

      // AI account metadata (no secrets) - private to owner
      match /aiAccounts/{accountId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Todo items - private to owner. Added in v1.0.2 hotfix; previously
      // todos relied on iCloud SwiftData/CloudKit only, which silently no-
      // ops for users with iCloud Sync disabled (the default).
      match /todos/{todoId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Travel events (flights / trains / etc) - private to owner.
      // Added in v1.0.2 hotfix; was deferred from initial Travel rollout.
      match /travelEvents/{travelId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Focus sessions (focus history backing analytics + study space
      // unlocks) - private to owner.
      match /focusSessions/{sessionId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Study space items (desk decoration unlocks) - private to owner.
      // Doc id is the catalog string (e.g. "desk_lamp"), giving us
      // idempotent writes when the user unlocks the same item from
      // two devices simultaneously.
      match /spaceItems/{itemId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Study Room - any authed user can read; a user can only write their own document
    match /studyRoom/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Group Focus - readable by everyone (room discovery / lobby),
    // writeable only by participants. Host is identified by hostUid;
    // members live in memberUids. Pre-1.0.3 any authed user could
    // mutate or delete any room.
    match /groupFocus/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      // hostUid is pinned (no host seizure) and the only memberUids change a
      // caller may make is adding or removing THEMSELVES. Status updates leave
      // memberUids untouched. Previously any member — or a non-member who
      // self-added — could rewrite the whole room and steal the host slot.
      allow update: if request.auth != null
                    && request.resource.data.hostUid == resource.data.hostUid
                    && (request.auth.uid in resource.data.memberUids
                        || request.auth.uid in request.resource.data.memberUids)
                    && (
                         (request.resource.data.memberUids.removeAll(resource.data.memberUids).size() == 0
                            && resource.data.memberUids.removeAll(request.resource.data.memberUids).hasOnly([request.auth.uid]))
                      || (resource.data.memberUids.removeAll(request.resource.data.memberUids).size() == 0
                            && request.resource.data.memberUids.removeAll(resource.data.memberUids).hasOnly([request.auth.uid]))
                       );
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.hostUid;
    }

    // Team Projects - members can read, authed users can create/update
    match /projects/{projectId} {
      allow read: if request.auth != null;
      // Creator must stamp themselves as owner and be in the initial member
      // list (no fabricating projects owned by / pre-populated with others).
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      // Immutable createdBy/createdAt/projectCode + self-only membership delta.
      // Closes the ownership-hijack / mass-kick / non-member-bulk-grant holes:
      // the previous rule did NO field validation, so any member (or a
      // non-member who added their own uid) could rewrite the entire doc.
      allow update: if request.auth != null
                    && projImmutableFieldsOK()
                    && (request.auth.uid in resource.data.memberIds
                        || request.auth.uid in request.resource.data.memberIds)
                    && projMembershipDeltaSelfOnly();
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;

      // Project dues - members only. Pre-1.0.3 any authed user could
      // read/write any project's dues, leaking work content + allowing
      // arbitrary vandalism.
      match /dues/{dueId} {
        allow read, write: if isProjectMember(projectId);
      }

      // Meetup locations - members read, owner of doc writes & deletes.
      // Pre-1.0.3 any authed user could delete another member's
      // location share, breaking real-time coordination during meetups.
      match /meetupLocations/{uid} {
        allow read: if isProjectMember(projectId);
        allow write, delete: if request.auth.uid == uid
                             && isProjectMember(projectId);
      }

      // Meetup history archive - members read & write. The device that
      // detects the 6h timeout writes the snapshot, and any project
      // member could be that device.
      match /meetupHistory/{meetupId} {
        allow read, write: if isProjectMember(projectId);
      }

      // Project activity log - members read & create. Pre-1.0.3 any
      // authed user could spam activity logs of projects they weren't
      // even in.
      match /activities/{activityId} {
        allow read, create: if isProjectMember(projectId);
      }
    }
  }
}
